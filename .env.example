# Copie para .env.local (já ignorado pelo git) e preencha os valores reais.
# Nunca commitar valores reais neste arquivo.

# Supabase (catálogo)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Segfy — Widget White Label (token público, embutido no <script> da página)
# Pode ter prefixo VITE_: é visível no HTML por design da própria Segfy.
VITE_SEGFY_TOKEN=
VITE_SEGFY_ENV=production

# Segfy — API completa (client_id/client_secret)
# NUNCA prefixar com VITE_. Só existem no servidor (Serverless Functions em /api),
# nunca chegam ao navegador. Configurar em Vercel > Project Settings > Environment
# Variables, e localmente apenas em .env.local (nunca commitar).
SEGFY_CLIENT_ID=
SEGFY_CLIENT_SECRET=
SEGFY_API_BASE_URL=https://api.automation.segfy.com

# Segfy — token da corretora (config.token), exigido dentro do corpo de toda
# chamada da API de veículo, além do Bearer acima. É provavelmente o mesmo
# valor recebido por e-mail para o widget White Label — confirme com a Segfy.
# Também nunca prefixar com VITE_: é injetado só no backend (api/segfy/vehicle).
SEGFY_BROKER_TOKEN=

# Opcional: restringe quem pode chamar /api/segfy/* (protege contra terceiros
# usando seu proxy para consumir sua cota da Segfy). Domínio(s) separados por vírgula.
ALLOWED_ORIGIN=
