# Copie para .env.local (já ignorado pelo git) e preencha os valores reais.
# Nunca commitar valores reais neste arquivo.

# Supabase (catálogo)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Segfy — Widget White Label (token público, embutido no <script> da página)
# Pode ter prefixo VITE_: é visível no HTML por design da própria Segfy.
VITE_SEGFY_TOKEN=
VITE_SEGFY_ENV=production

# Segfy — API completa (client_id/client_secret)
# NUNCA prefixar com VITE_. Só existem no servidor (Serverless Functions em /api),
# nunca chegam ao navegador. Configurar em Vercel > Project Settings > Environment
# Variables, e localmente apenas em .env.local (nunca commitar).
SEGFY_CLIENT_ID=
SEGFY_CLIENT_SECRET=
SEGFY_API_BASE_URL=https://api.automation.segfy.com

# Segfy — token da corretora (config.token), exigido dentro do corpo de toda
# chamada da API de veículo, além do Bearer acima. É provavelmente o mesmo
# valor recebido por e-mail para o widget White Label — confirme com a Segfy.
# Também nunca prefixar com VITE_: é injetado só no backend (api/segfy/vehicle).
SEGFY_BROKER_TOKEN=

# Opcional: restringe quem pode chamar /api/segfy/* (protege contra terceiros
# usando seu proxy para consumir sua cota da Segfy). Domínio(s) separados por vírgula.
ALLOWED_ORIGIN=
# Em produção: https://escolha-seu-ev.vercel.app (origem exata; várias separadas por vírgula)

# E-mails da escolha do plano (api/segfy/choose.js) — via SMTP da caixa de
# automações da D&B. Nunca prefixar com VITE_: só existem no servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=D&B Corretora <automacoes@dbcorr.com.br>
DB_NOTIFY_EMAIL=eduardo@dbcorr.com.br

# Registro das cotações (tabela quote_events, supabase/schema-quote-events.sql)
# e relatório semanal (api/cron/quote-report.js). Só no servidor.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel envia "Authorization: Bearer <CRON_SECRET>" ao chamar o cron.
CRON_SECRET=
REPORT_EMAILS=neckin@gmail.com,eduardo@dbcorr.com.br

# Instagram/Facebook automático (scripts/instagram-kit, GitHub Actions).
# Vão como secrets do repositório, nunca no front.
# Token de usuário do sistema do Business Manager (não expira).
META_ACCESS_TOKEN=
FB_PAGE_ID=
# Opcional: descoberto pela Página se ficar vazio.
IG_USER_ID=
# Opcional: id do local marcado nos posts (ex.: Águas Claras).
IG_LOCATION_ID=
# Windsor.ai (desempenho dos posts; escolhe o tema da semana).
WINDSOR_API_KEY=
# Linha de registro da corretora no rodapé das legendas, se a D&B exigir.
SUSEP_REGISTRO=
